# Copy to .env and adjust. All values have sensible defaults; nothing is required to run.

DATABASE_URL=sqlite:///./fireflies.db
CORS_ORIGINS=http://localhost:3000

# Auto-load demo data on startup when the DB is empty (non-destructive).
AUTO_SEED=true

# Optional LLM (hybrid mode). Leave provider as "none" to use the offline engine.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
